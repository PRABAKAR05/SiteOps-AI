# ---------------------------------------------------------------------------
# SiteOps AI — backend configuration (copy to backend/.env, never commit)
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=development                 # development | test | production
APP_NAME=SiteOps AI
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list. Empty in development = allow localhost defaults.
CORS_ORIGINS=http://localhost:5173

# Public origin used when building links in PDFs/notifications
PUBLIC_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=siteops
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Authentication
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET and JWT_REFRESH_SECRET must differ and be >= 32 bytes.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_ACCESS_TOKEN_SIGNING_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_TOKEN_SIGNING_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=siteops_refresh
REFRESH_COOKIE_SECURE=false          # true in production (HTTPS)
REFRESH_COOKIE_SAMESITE=lax          # lax | strict | none (none requires secure=true)

# Argon2 parameters (passlib CryptContext)
PASSWORD_HASH_SCHEME=argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# ---------------------------------------------------------------------------
# AI — Groq (optional in development; features degrade without it)
# Model IDs change; confirm at https://console.groq.com/docs/models
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_REQUEST_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=1024
# Set only if you have verified a vision-capable model on your account.
GROQ_VISION_MODEL=
AI_ENABLED=true                      # false = force degraded mode (useful for tests)

# Speech-to-text
STT_PROVIDER=local                   # local | groq
WHISPER_MODEL=base                   # tiny | base | small | medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
MAX_AUDIO_MB=25
MAX_AUDIO_SECONDS=300

# OCR
OCR_ENGINE=tesseract                 # tesseract only in v1
TESSERACT_CMD=tesseract              # path to binary if not on PATH
OCR_LANGUAGES=eng

# Embeddings / vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHROMA_DIR=./chroma
RAG_CHUNK_TOKENS=450
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=6
RAG_MIN_SCORE=0.25

# ---------------------------------------------------------------------------
# Files and storage
# ---------------------------------------------------------------------------
STORAGE_DIR=./var/uploads
MAX_DOCUMENT_MB=20
MAX_INVOICE_MB=10
MAX_IMAGE_MB=8
MAX_PHOTOS_PER_REPORT=6

# ---------------------------------------------------------------------------
# Rate limiting (per user, per window)
# ---------------------------------------------------------------------------
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_15_MIN=10

# ---------------------------------------------------------------------------
# Demo seed data (fictional). Never enabled in production.
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=false
DEMO_PASSWORD=                    # generate a unique password; never commit a real one
