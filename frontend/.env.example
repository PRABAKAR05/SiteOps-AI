# SiteOps AI — frontend configuration (copy to frontend/.env)
# Only public, non-secret values belong here. They are embedded in the bundle.

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=SiteOps AI
VITE_ENABLE_DEMO_BANNER=true
# Optional, for seeded demo accounts only. Do not enable in a real deployment.
# VITE_DEMO_PASSWORD=
